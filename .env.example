# MosiMosi / PDA — shared environment
# Copy to `.env` and adjust. Do not commit `.env`.

# ── General ──────────────────────────────────────────────
PROJECT_NAME=mosi-mosi
DOMAIN=localhost
NODE_ENV=production

# Public URLs (browser-facing)
WEB_URL=http://localhost:3020
API_URL=http://localhost:3011
NEXT_PUBLIC_API_URL=http://localhost:3011

# Host port mappings
WEB_PORT=3020
API_PORT=3011
POSTGRES_PORT=5433

# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=mosi
POSTGRES_PASSWORD=mosi
POSTGRES_DB=mosi

# Inside Docker network use host `postgres`; from the host machine use localhost + POSTGRES_PORT
DATABASE_URL=postgresql://mosi:mosi@localhost:5433/mosi

# ── Auth (Better Auth on Nest / brain) ───────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3011
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Seeded on API container start if missing
SEED_ADMIN_EMAIL=admin@mosimosi.local
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin
